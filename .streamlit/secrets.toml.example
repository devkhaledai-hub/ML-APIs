# Copy this file to .streamlit/secrets.toml and fill in your values.
# Do not commit .streamlit/secrets.toml.

GCS_BUCKET_NAME = "your-bucket-name"
GCS_UPLOAD_PREFIX = "streamlit-label-uploads"
GOOGLE_CLOUD_PROJECT = "your-google-cloud-project-id"

# Optional: only needed when you choose "API key" in the app.
GOOGLE_VISION_API_KEY = "your-restricted-vision-api-key"

# Option A:
# For local development you can skip this block and set GOOGLE_APPLICATION_CREDENTIALS
# to the path of your service account JSON file instead.

# Option B:
# Paste the service account JSON fields here for Streamlit secrets.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-google-cloud-project-id"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "your-service-account@your-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"
